SWPM_TASK_DATA_MODE=legacy-cache
SWPM_LEGACY_ALM_CACHE=C:\path\to\python_Jenkins _door_QC_ALM_GUI\.app_cache\alm\alm_cache.json
SWPM_LEGACY_ALM_SCOPE=
SWPM_DOORS_ENABLED=true
SWPM_LEGACY_JENKINS_ROOT=C:\path\to\python_Jenkins _door_QC_ALM_GUI\.app_cache\jenkins
SWPM_LEGACY_CONFIG=C:\path\to\python_Jenkins _door_QC_ALM_GUI\.app_cache\config\config.json
SWPM_DOORS_DERIVED_CACHE=backend/.cache/doors_tasks.json
SWPM_DOORS_MAX_RECORDS=50000

# Set SWPM_TASK_DATA_MODE=live to query RTC/ALM directly.
RTC_ALM_SERVER=https://rb-alm-06-p.de.bosch.com
RTC_ALM_PROJECT_AREA=_UkehAJxnEeeWvYReE95djA
RTC_ALM_USERNAME=
RTC_ALM_PASSWORD=
RTC_ALM_ITERATION_ID=
RTC_ALM_ITERATION_NAME=

# Keep certificate verification enabled. For an internal CA, set the PEM bundle path.
RTC_ALM_CA_BUNDLE=
RTC_ALM_VERIFY_SSL=true
RTC_ALM_TRUST_ENV=false
RTC_ALM_TIMEOUT_SECONDS=20
RTC_ALM_CACHE_TTL_SECONDS=300
